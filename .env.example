# ─── TradiChatter Admin Portal ─────────────────────────────────────────────────
# Environment Configuration
# Copy to .env.local for development

NODE_ENV=development

# ─── Supabase (Primary Database — same as mobile app) ─────────────────────────
SUPABASE_URL=https://pdqhtkshsviayusxeytt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://pdqhtkshsviayusxeytt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Admin Auth ───────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=your-admin-jwt-secret-32-chars-minimum
ADMIN_SESSION_TIMEOUT=3600000

# ─── Microservice URLs ────────────────────────────────────────────────────────
RUST_BACKEND_URL=http://localhost:8080
AI_AGENT_SERVICE_URL=http://localhost:8100
VOICE_TRANSLATION_URL=http://localhost:8200
SOURCEHUB_URL=http://localhost:8300
AVS_ENGINE_URL=http://localhost:8400

# ─── Microservice API Keys (internal auth) ────────────────────────────────────
RUST_SERVICE_TOKEN=your-rust-backend-api-key
AI_AGENT_API_KEY=your-ai-agent-service-api-key
VOICE_TRANSLATION_API_KEY=your-voice-translation-api-key
SOURCEHUB_API_KEY=your-sourcehub-api-key
AVS_API_KEY=your-avs-engine-api-key

# ─── Payment Gateways (for admin financial operations) ────────────────────────
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# ─── Legacy Appwrite (read-only, for migration period) ────────────────────────
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=69382507000a9ac8f4f4
NEXT_PUBLIC_APPWRITE_DATABASE_ID=main
APPWRITE_API_KEY=your-appwrite-api-key

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=admin@tradichatter.com

# ─── Redis (sessions, rate limiting) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Security ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3002,https://admin.tradichatter.com
ENABLE_RATE_LIMITING=true
